# =====================================================================
# Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.
# =====================================================================

# Application Environment & Debugging (dev/prod)
YII_DEBUG=true
YII_ENV=dev

# Application Security Key (generate a random 32-character string for production)
COOKIE_VALIDATION_KEY=your_secret_cookie_validation_key_here

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=admission_odisha
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Mailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=smtps
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Email Notifications
ADMIN_EMAIL=admin@admissionodisha.com
SENDER_EMAIL=noreply@admissionodisha.com
SENDER_NAME="Admission Odisha"
