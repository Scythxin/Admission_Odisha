# Disable execution of all scripts in uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|bash|exe|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent script engine execution if running with mod_php
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent direct execution of scripts
Options -ExecCGI -Indexes
